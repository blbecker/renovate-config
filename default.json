{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "github>aquaproj/aqua-renovate-config#2.13.0"
  ],
  "packageRules": [
    {
      "description": "Group development dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development dependencies"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge dependency pinning updates",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "automerge": true
    }
  ]
}
